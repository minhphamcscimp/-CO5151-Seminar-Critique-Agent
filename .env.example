# Copy to .env (never commit .env). Or set the variable in your shell.
GEMINI_API_KEY=

# Optional. Model used by every agent when running with --llm gemini.
# Keep ONE model for configs A, B and C so the comparison changes one thing only.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Override the token prices (USD per 1M tokens) used for cost_usd.
# Defaults and the date they were read are in seminar_critique/llm/pricing.py.
# GEMINI_PRICE_IN_PER_M=0.10
# GEMINI_PRICE_OUT_PER_M=0.40
